GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_SENDER_EMAIL=
GOOGLE_REFRESH_TOKEN= # paste token only, no quotes or trailing commas
GOOGLE_CALENDAR_ID=primary

# Postgres (e.g. Neon from the Vercel Marketplace)
DATABASE_URL=

# Temporal (Temporal Cloud: address like <region>.<cloud>.api.temporal.io:7233, namespace like <ns>.<account-id>)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=calendly-tasks
TEMPORAL_API_KEY=

# SMTP (use a real provider in production, e.g. Resend, SendGrid, Gmail app password)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Calendly <noreply@example.com>
